[Unit]
Description=IMMODERMA Gunicorn service
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/opt/immoderma
EnvironmentFile=/etc/immoderma/immoderma.env
Environment=DJANGO_SETTINGS_MODULE=IMMODERMA.settings_production
ExecStart=/opt/immoderma/.venv/bin/gunicorn IMMODERMA.wsgi:application --workers 3 --bind unix:/run/immoderma.sock --access-logfile - --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

