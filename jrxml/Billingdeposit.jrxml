		<property name="com.jaspersoft.studio.field.name" value="NAMA_PRODUK"/>
		<property name="com.jaspersoft.studio.field.label" value="NAMA_PRODUK"/>
	</field>
	<variable name="Amount" class="java.lang.Double">
		<variableExpression><![CDATA[$F{QTY}*$F{HARGA}]]></variableExpression>
	</variable>
	<variable name="totdisckonsumen" class="java.lang.Double">
		<variableExpression><![CDATA[$V{Amount}* ($F{DISCKONSUMEN} / 100)]]></variableExpression>
	</variable>
	<variable name="totdisc" class="java.lang.Double">
		<variableExpression><![CDATA[($V{Amount} - $V{totdisckonsumen}) * ($F{DISC} / 100)]]></variableExpression>
	</variable>
	<variable name="totdisc2" class="java.lang.Double">
		<variableExpression><![CDATA[($V{Amount} - $V{totdisckonsumen} - $V{totdisc}) * ($F{DISC2} / 100)]]></variableExpression>
	</variable>
	<variable name="totdisc3" class="java.lang.Double">
		<variableExpression><![CDATA[($V{Amount} - $V{totdisckonsumen} - $V{totdisc} - $V{totdisc2}) * ($F{DISC3} / 100)]]></variableExpression>
	</variable>
	<variable name="res" class="java.lang.Double">
		<variableExpression><![CDATA[CEIL( $V{Amount} - $V{totdisckonsumen} - $V{totdisc} - $V{totdisc2} - $V{totdisc3} - $F{DISC4})]]></variableExpression>
	</variable>
	<variable name="Total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$V{res}]]></variableExpression>
	</variable>
