	<queryString language="SQL">
		<![CDATA[select  a.*,b.FDFJPRD_ID,FDFJNOM,FDFJBRG_ID,FDFJBRGN,FDFJSATUAN,  FDFJHJUAL,FDFJQTY,FDFJDISC1,FDFJDISC4,FDFJEMBALAGE,FDFJTOTAL,FDFJJENISTARIP,
c.NAMA_RESELER,d.NAME_WH
from  FJINKOTA a INNER JOIN FJINKOTAD b ON  a.FHFJBUKTI_ID=b.FDFJBUKTI_ID  
LEFT JOIN RESELER c ON a.FHFJPOLY_ID=c.KD_RESELER
LEFT JOIN WAREHOUSE d on a.FHFJWH_ID=d.WH_ID
where   a.FHFJBUKTI_ID = $P{nomor}   ORDER BY FDFJNOM]]>
	</queryString>
