	<parameter name="nama_rs" class="java.lang.String"/>
	<parameter name="tanggal_waktu_cetak" class="java.lang.String"/>
	<parameter name="nomor" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT ROW_NUMBER() OVER (ORDER BY NAME_BRG) AS NO,BBBULAN, BBDATE, BBSUPP_ID as KODE_SUPP, BBUSERS, BBUPDATE, BBWH_ID,BBQTY_HPOKOK as HARGA_POKOK,BBQTY_SAWAL as QTY,b.NAME_SUPPL,c.NAME_WH,
d.BARANGC as ID_BARANG,d.NAME_BRG as NAMA_BARANG,d.SATSTAND as SATUAN
FROM BBALINV as a inner join 
SUPPLIER as b on a.BBSUPP_ID=b.SUPPLIERC  inner join  
WAREHOUSE as c on a.BBWH_ID=c.WH_ID inner join  
BARANG as d on a.BBBRG_ID=d.BARANGC WHERE
 a.BBBULAN= $P{nomor}
 order by NAME_WH,NAME_BRG]]>
	</queryString>
